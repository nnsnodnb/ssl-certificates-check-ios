{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "Develop",
      "children": [
        { "path": "Info.plist" },
        { "path": "Develop.entitlements" },
        { "path": "DevelopApp.swift", "target-membership": [ "Develop/compile-sources" ] },
        { "path": "GoogleService-Info.plist", "encoding": "utf8", "target-membership": [ "Develop/resources" ] },
        { "path": "Assets.xcassets", "target-membership": [ "Develop/resources" ] },
        { "path": "PrivacyInfo.xcprivacy" },
        { "path": "<PROJECT>/../CertsCheck.storekit", "target-membership": [ "Develop/resources" ] },
        {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "Develop/resources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "ShareExtensionDevelop",
      "children": [
        { "path": "../../ShareExtension/ShareViewController.swift", "encoding": "utf8", "target-membership": [ "ShareExtensionDevelop/compile-sources" ] },
        {
          "kind": "variant-group",
          "name": "MainInterface.storyboard",
          "target-membership": [
            "ShareExtensionDevelop/resources",
          ],
          "children": [
            {
              "path": "Base.lproj/MainInterface.storyboard",
            },
          ],
        },
        { "path": "Info.plist" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Develop.app", "id": "CF7E0EB32AD835C7003244D1", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ShareExtensionDevelop.appex", "id": "CFECF1A32ADD5D9000E86AC0", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Develop/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "kind": "group", "name": "Frameworks" },
  ],
  "targets": [
    {
      "name": "Develop",
      "id": "CF7E0EB22AD835C7003244D1",
      "product": "Products/Develop.app",
      "product-type": "application",
      "dependencies": [
        "ShareExtensionDevelop",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed App Clips",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/AppClips",
        },
      ],
      "package-product-members": [
        {
          "product-name": "DependenciesLive",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SSLCertificateCheckPackage",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Develop/Develop.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_ASSET_PATHS": "\"Develop/Preview Content\"",
        "DEVELOPMENT_TEAM": "99649YXF6E",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "Develop/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "CertsCheck",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_NSCameraUsageDescription": "The camera is used to scan QR codes.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_DEPRECATE_APPLICATION_MAIN": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "ShareExtensionDevelop",
      "id": "CFECF1A22ADD5D9000E86AC0",
      "product": "Products/ShareExtensionDevelop.appex",
      "product-type": "app-extension",
      "last-swift-migration": "15.0",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "Share",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "99649YXF6E",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "ShareExtensionDevelop/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "ShareExtensionDevelop",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "moe.nnsnodnb.SSLCertificateCheck.ShareExtension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
